generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ExpenseType {
  FIXED_RECURRING
  VARIABLE_RECURRING
  ONE_TIME
  UNKNOWN
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   // hex, e.g. "#E53935"
  icon      String   // Material icon name, e.g. "restaurant"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchants    Merchant[]
  transactions Transaction[]
  budgets      Budget[]
}

// ─── Merchants ───────────────────────────────────────────────────────────────

model Merchant {
  id          String      @id @default(cuid())
  name        String      @unique // normalized, e.g. "LIDL"
  displayName String?              // human-friendly override
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  expenseType ExpenseType @default(UNKNOWN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactions Transaction[]
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id       String   @id @default(cuid())
  date     DateTime
  label    String   // raw bank label
  amount   Decimal  @db.Decimal(12, 2) // negative = expense
  currency String   @default("EUR")

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  expenseType ExpenseType @default(UNKNOWN)
  isManual    Boolean     @default(false) // manually added vs imported

  // Dedup key: SHA-256 of (date + amount + label)
  fingerprint String @unique

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([merchantId])
}

// ─── Import Batches ───────────────────────────────────────────────────────────

model ImportBatch {
  id            String   @id @default(cuid())
  filename      String
  rowCount      Int
  importedCount Int
  skippedCount  Int      // fingerprint duplicates
  createdAt     DateTime @default(now())

  transactions Transaction[]
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  monthYear  String   // "2024-03"
  cap        Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, monthYear])
}
